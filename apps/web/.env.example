# Web app environment — copy to .env.local for local overrides.
# Point this at the API (defaults to localhost:4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel only: proxy the API through the web origin so auth cookies remain
# first-party. Set NEXT_PUBLIC_API_URL to https://<web>.vercel.app/backend.
# API_PROXY_TARGET=https://<api>.vercel.app
