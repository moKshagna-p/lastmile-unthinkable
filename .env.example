# ── Database ────────────────────────────────────────────────────────────────
# Local dev via `bun run db:up` (docker-compose) or any Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lastmile

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# Signing secret — REQUIRED in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the API (where auth cookies are issued).
BETTER_AUTH_URL=http://localhost:4000

# ── CORS / URLs ─────────────────────────────────────────────────────────────
API_PORT=4000
WEB_URL=http://localhost:3000

# ── Auto-assignment tuning ──────────────────────────────────────────────────
# Max radius (km) an agent may be from the pickup area to be auto-assigned.
AGENT_MAX_RADIUS_KM=25

# ── Email (Resend free tier — https://resend.com). Optional: if unset, emails
# are stored in the `notifications` table and logged to console (dev mode).
RESEND_API_KEY=
EMAIL_FROM="LastMile <onboarding@resend.dev>"

# ── SMS (Twilio trial — https://twilio.com). Optional: same fallback applies.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
